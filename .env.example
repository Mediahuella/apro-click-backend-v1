# Cognito — values available after deploying the users service
# Check CloudFormation outputs: apro-click-admin-users stack
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# PostgreSQL (RDS) — used by services that access the database
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Servicio users (opcional): override del UUID de empresa plataforma si no hay fila con is_system en companies.
APRO_CLICK_COMPANY_ID=

# Shopify app (Partner / Dev Dashboard) — OAuth vía servicio shopify
# https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/authorization-code-grant
SHOPIFY_CLIENT_ID=
# Necesario en Lambda para HMAC + intercambio de token en /oauth/callback; mismo secret para el webhook de pedidos
SHOPIFY_CLIENT_SECRET=
# Scopes ejemplo: read_products,write_products,read_orders,write_orders,write_order_edits,read_order_edits,read_users
# write_orders: requerido por la mutación orderInvoiceSend (POST /orders/{id}/send-invoice del panel CRM)
# read_users: vincular usuarios del panel con StaffMember (staffMembers); suele exigir tienda Plus/Advanced o habilitación en Partners
# Pedidos CRM: REST + Order Edit GraphQL; read_products hace falta si se agregan líneas por SKU (productVariants)
SHOPIFY_OAUTH_SCOPES=
# Redirect URL registrada en la app = URL pública del API + /api/v1/shopify/oauth/callback
SHOPIFY_OAUTH_REDIRECT_URI=
# Tras guardar token: 302 al conector con ?shop=&oauth_status=success&installation_id=
SHOPIFY_CONNECTOR_URL=
# Versión Admin API GraphQL (aprobar solicitudes → customerCreate en Shopify)
SHOPIFY_API_VERSION=2026-04
# Sync masivo npm run sync:stock (scripts/sync_stock_bulk.py) — offline token Admin con write_products
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
# Servicio orders / inventory webhook → metafield leído por la function
# `manejo-de-pagos` (Payment Customization). Defaults coinciden con la function.
SHOPIFY_STOCK_NAMESPACE=aproclick
SHOPIFY_STOCK_KEY=stock
# (Opcional, servicio users) Invitar/crear staff: la API pública de Shopify no incluye eso. Tras un POST JSON
# con { userId, email, givenName, familyName, shopDomain } puede devolver { "shopifyStaffMemberGid": "gid://shopify/StaffMember/..." }.
# SHOPIFY_STAFF_PROVISIONER_URL=
# SHOPIFY_STAFF_PROVISIONER_API_KEY=

# Servicio company-registration: si tiene valor, el POST público exige header X-Api-Key; vacío = sin API key
COMPANY_REGISTRATION_API_KEY=

# Servicio chat (theme extension): mismo patrón; el panel usa Cognito Bearer token
CHAT_STOREFRONT_API_KEY=

# -----------------------------------------------------------------------------
# Servicio prices — sube Excel de listas de precio y crea catálogos B2B en
# Shopify (PriceList por segmento PYME / MEDIANA / GRAN_EMPRESA). El
# Excel se guarda en S3 y el procesamiento corre en una Lambda SQS.
# -----------------------------------------------------------------------------

# Moneda fija de los catálogos B2B (Chile = CLP).
PRICES_B2B_CURRENCY=CLP

# CSV opcional de gid://shopify/CompanyLocation/... para asociar al Catalog
# del segmento la primera vez que se crea. Si quedan vacíos, el worker sólo
# crea el PriceList y el admin debe linkear el Catalog manualmente en
# Shopify (companyLocationIds es required en catalogCreate).
PRICES_B2B_PYME_LOCATION_IDS=
PRICES_B2B_MEDIANA_LOCATION_IDS=
PRICES_B2B_GRAN_EMPRESA_LOCATION_IDS=

# ----------------------------------------------------------------------------
# Carga de precios B2C/WEB — tienda Shopify B2C (aproltda), DISTINTA de aproclick.
# Su token NO está en shopify_app_installations: vive solo aquí (env del Lambda).
# Equivalen a las claves APRO-B2C-* del .env raíz del monorepo (aquí con guion
# bajo para que Serverless las resuelva con ${env:...}).
# ----------------------------------------------------------------------------
APRO_B2C_URL=aproltda.myshopify.com
APRO_B2C_TOKEN=
APRO_B2C_VERSION=2026-04

# Bucket S3 y URL de la cola SQS — los expone el deploy del servicio prices
# (CloudFormation outputs: apro-click-<stage>-prices-uploads-bucket /
# -queue-url). Para tests locales:
# PRICES_UPLOADS_BUCKET=
# PRICES_UPLOADS_QUEUE_URL=

# -----------------------------------------------------------------------------
# Servicio notifications — cola SQS + envío de emails vía AWS SES
# El servicio notifications es dueño de la cola y del envío.
# Otros servicios (company-registration, etc.) solo encolan mensajes.
# -----------------------------------------------------------------------------

# Remitente SES — verificar en SES antes del deploy a prod:
#   aws ses verify-email-identity --email-address notificaciones@aproclick.cl --region us-east-1
# En sandbox SES (dev), también verificar los emails destinatarios.
SES_FROM_EMAIL=notificaciones@aproclick.cl
SES_REGION=us-east-1

# URL de la cola SQS — la expone el deploy del servicio notifications
# (CloudFormation export: apro-click-<stage>-notifications-queue-url).
# En company-registration se inyecta vía Fn::ImportValue en serverless.yml.
# Para pruebas locales o scripts externos:
# NOTIFICATIONS_QUEUE_URL=

# ---- Servicio quotes (cotizaciones B2B) ----
# Clave del canal público (header X-Api-Key); mismo valor en el setting
# quotes_api_key de los bloques cart-quote / my-quotes del theme.
QUOTES_PUBLIC_API_KEY=
# Secreto HMAC del link de descarga del PDF por email (genera con: openssl rand -hex 32).
QUOTES_PDF_LINK_SECRET=
# Base URL pública del API quotes (tras el primer deploy): https://<api-id>.execute-api.us-east-2.amazonaws.com
QUOTES_PUBLIC_BASE_URL=
# APRO IA (DMS externo) — API de cotizaciones. QA: https://dms-qa.apro.cl / Prod: https://dms.apro.cl
APRO_IA_BASE_URL=
# APRO IA (DMS externo) — API de clientes (company-registration). QA: https://cliente-qa.apro.cl / Prod: https://clientes.apro.cl
APRO_IA_CLIENTS_BASE_URL=

# ---- Servicio invoices — canal storefront (consulta de facturas por OC) ----
# Clave del canal público (header X-Api-Key); mismo valor en el setting
# invoices_api_key del bloque apro-click.invoices-lookup del theme.
INVOICES_PUBLIC_API_KEY=
# DMS externo APRO — consulta de facturas/recepciones por OC. QA/Prod: https://dms.apro.cl
DMS_INVOICES_BASE_URL=https://dms.apro.cl
# Reutiliza el mismo APRO_IA_BEARER_TOKEN de más abajo (distinto host, mismo DMS).

# ---- Servicio companies — canal storefront (autogestión de sucursales) ----
# Clave del canal público (header X-Api-Key); mismo valor en el setting
# addresses_api_key del bloque apro-click.company-addresses del theme.
COMPANIES_PUBLIC_API_KEY=
# Cupo de crédito de la empresa (GET /api/v1/storefront/company/credit, que
# alimenta la checkout UI extension credito-b2b). El contrato del endpoint está
# PENDIENTE de confirmar con APRO IA: mientras la URL esté vacía, el endpoint
# responde solo la habilitación (enabled) y el checkout muestra las condiciones
# sin montos. Usa el mismo APRO_IA_BEARER_TOKEN.
# (obsoleto: el DMS nunca publicó un endpoint de cupo con montos)

# --- APRO — servicio de créditos ---------------------------------------------
# Fuente de verdad de si una empresa puede pagar con crédito.
#   GET {APRO_CREDIT_BASE_URL}/credits/client/{rut}  ->  200 con credit.folio
#                                                        404 si no tiene
# Lo consumen: el job diario `companies` creditSync, el alta de empresa en
# `company-registration` y el endpoint del checkout. Con la URL vacía la
# sincronización NO corre y ninguna empresa cambia de payment_type.
# QA: https://cliente-qa.apro.cl  ·  Productivo: PENDIENTE de que APRO lo envíe.
# Ojo: el stage `dev` atiende la tienda productiva — apuntarlo a QA apagaría el
# crédito de los clientes reales (en QA casi todos responden 404).
APRO_CREDIT_BASE_URL=
APRO_CREDIT_PATH_TEMPLATE=/credits/client/{rut}
# Mismos valores que APRO_IA_BEARER_TOKEN, pero variable propia: son servicios
# distintos y APRO puede rotarlos por separado.
APRO_CREDIT_BEARER_TOKEN=
# RUTs que siempre se consideran con crédito, separados por coma (empresas de
# prueba que deben tener el medio de pago disponible aunque el DMS diga que no).
APRO_CREDIT_FORCE_RUTS=76486379-8
# Token Bearer de APRO IA (compartido entre ambas APIs). Los valores de QA y
# producción NO van acá: pedirlos al equipo y cargarlos solo en el .env local.
APRO_IA_BEARER_TOKEN=

# --- Ambiente QA de APRO IA (dms-qa.apro.cl) ---
# Credenciales propias: el token de produccion devuelve 403 contra QA.
# Si quedan vacias, el espejo a QA no corre y las rutas
# /api/v1/quotes/webhooks/apro-ia/qa[/transferencias] responden ignored.
APRO_IA_BASE_URL_QA=
APRO_IA_BEARER_TOKEN_QA=
APRO_IA_CLIENTS_BASE_URL_QA=
# RUTs habilitados para QA, coma-separados (ej. 76486379-8). Vacio = QA apagado.
APRO_IA_QA_ALLOWED_RUTS=
# Clave que APRO IA debe enviar en el header x-api-key de su webhook de eventos
# (quotation.created/updated/approved/rejected -> POST /api/v1/quotes/webhooks/apro-ia).
# Nuestra, generada con: openssl rand -hex 16. Entregar a APRO IA, no la que ellos generan.
APRO_IA_WEBHOOK_API_KEY=
# Vendedor por defecto (email y código SAP) para cotizaciones sin vendedor asignado
# (Company.referred_by_user_id vacío). Debe estar registrado en APRO IA DMS.
APRO_IA_DEFAULT_SELLER_EMAIL=
APRO_IA_DEFAULT_SELLER_SAP_CODE=000

# ---- Servicio error-logs (control de errores frontend) ----
# Clave del canal público (header X-Api-Key) para que el panel admin reporte un
# cierre de sesión inesperado desde /login, cuando ya no queda ningún access
# token válido para autenticar el POST normal. Genera con: openssl rand -hex 16.
# Mismo valor en NEXT_PUBLIC_ERROR_LOGS_SESSION_EVENTS_API_KEY del frontend.
ERROR_LOGS_SESSION_EVENTS_API_KEY=
